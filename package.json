{
  "name": "a9-telemetry-lab",
  "private": true,
  "version": "1.7.2",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "cn.realxd.a9telemetrylab",
    "productName": "A9 Telemetry Lab",
    "artifactName": "A9-Telemetry-Lab-${version}-portable.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tesseract.js": "latest",
    "xlsx": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "latest",
    "vite": "latest"
  },
  "allowScripts": {
    "electron@43.1.1": true
  }
}
